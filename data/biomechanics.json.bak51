{
  "meta": {
    "title": "NEUROVERSE — biomechanics / plexus learning",
    "version": "0.5.0",
    "disclaimer": "3D 움직임은 관절 자유도 중심의 교육용 모식 모델이며 환자의 실제 운동·근전도·근육 장력을 측정한 데이터가 아님. 실제 근육 활동은 과제·부하·자세 등에 따라 달라짐. 학술 문장 단위 검증 및 한국어 신구용어 공식 대조 전."
  },
  "movements": [
    {
      "id": "elbow_flex",
      "en": "Elbow flexion",
      "new": "팔꿈치 굽힘",
      "old": "주관절 굴곡",
      "joint": "elbow",
      "start": 0,
      "end": 135,
      "easy": "팔꿈치를 접어서 손을 어깨 쪽으로 가져가는 움직임이에요.",
      "expert": "위팔자관절을 중심으로 시상면에서 아래팔을 위팔에 가까이 하는 굽힘 운동이다. 위팔근·위팔두갈래근·위팔노근이 기여하며 근육의 기여도는 아래팔 회전 위치와 부하에 따라 달라진다.",
      "prime": [
        "brachialis"
      ],
      "synergist": [
        "biceps",
        "brachioradialis"
      ],
